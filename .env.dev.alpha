# config
APP_NAME=orch-auth-external
APP_PORT=8080
APP_ENV_STAGE=LOCAL

LOG_LEVEL=DEBUG
LOG_MASK_SENSITIVE_DATA=true

CORE_AUTH_API_SIGNUP_PATH=/auth/v1/signup
CORE_AUTH_API_DELETE_USER_PATH=/auth/v1/firebase-user
CORE_AUTH_API_MAX_CONNS=10
CORE_AUTH_API_MAX_RETRY=3
CORE_AUTH_API_TIMEOUT=10s
CORE_AUTH_API_INSECURE_SKIP_VERIFY=true

CORE_USER_API_SIGNUP_PATH=/user/v1/signup
CORE_USER_API_MAX_CONNS=10
CORE_USER_API_MAX_RETRY=3
CORE_USER_API_TIMEOUT=10s
CORE_USER_API_INSECURE_SKIP_VERIFY=true

# secret
CORE_AUTH_API_BASE_URL=http://host.docker.internal:1324
CORE_USER_API_BASE_URL=http://host.docker.internal:1324
