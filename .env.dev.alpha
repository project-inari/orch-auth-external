# config
APP_NAME=orch-auth-external
APP_PORT=8080
APP_ENV_STAGE=LOCAL

LOG_LEVEL=DEBUG
LOG_MASK_SENSITIVE_DATA=true

API_CORE_AUTH_SIGNUP_PATH=/auth/v1/signup
API_CORE_AUTH_DELETE_USER_PATH=/auth/v1/firebase-user
API_CORE_AUTH_MAX_CONNS=10
API_CORE_AUTH_TIMEOUT=10s
API_CORE_AUTH_INSECURE_SKIP_VERIFY=true

API_CORE_USER_SIGNUP_PATH=/user/v1/signup
API_CORE_USER_MAX_CONNS=10
API_CORE_USER_TIMEOUT=10s
API_CORE_USER_INSECURE_SKIP_VERIFY=true

# secret
API_CORE_AUTH_BASE_URL=http://host.docker.internal:1324
API_CORE_USER_BASE_URL=http://host.docker.internal:1324
